<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/numbers_points"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:backgroundTint="?attr/customBackground"
android:background="@drawable/bottom_sheet_background"
android:orientation="vertical"
android:padding="24dp">

<ImageView
    android:layout_width="40dp"
    android:layout_height="4dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginBottom="16dp"
    app:tint="?attr/textFillColor"
    android:src="@drawable/background_card_dark" />


    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        tools:ignore="MissingConstraints">

<!--        <ImageView-->
<!--            android:id="@+id/button_cancel"-->
<!--            android:layout_width="50dp"-->
<!--            android:layout_height="50dp"-->
<!--            android:backgroundTint="?attr/cardBackgroundColor"-->
<!--            android:background="@drawable/background_circle_yellow"-->
<!--            android:padding="12dp"-->
<!--            android:layout_marginRight="10dp"-->
<!--            app:tint="?attr/textFillColor"-->
<!--            android:src="@drawable/ic_arrow_back"-->
<!--            tools:ignore="ContentDescription" />-->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            app:layout_constraintStart_toEndOf="@+id/button_back">



            <TextView
                android:id="@+id/scoring_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÁZ"
                android:textColor="?attr/textFillColor"
                android:textSize="35sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NÚMERO 01"
                android:alpha="0.5"
                android:textColor="?attr/textFillColor"
                android:textSize="16sp" />

        </LinearLayout>

        <ImageView
            android:layout_height="50dp"
            android:layout_width="50dp"
            android:backgroundTint="?attr/cardBackgroundColor"
            android:background="@drawable/background_card_de_boca"
            android:src="@drawable/ic_dice_1"
            app:tint="?attr/colorPrimary"
            android:elevation="2dp"
            android:layout_margin="4dp"/>

    </LinearLayout>




</LinearLayout>