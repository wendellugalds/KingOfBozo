<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/item_background_selector"
    android:backgroundTint="?attr/cardBackgroundColor"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/container_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/sigla_nome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background_circle"
            android:backgroundTint="?attr/colorPrimary"
            android:gravity="center"
            android:textColor="?attr/customTextBackground"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="WU" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_player_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/container_action"
        app:layout_constraintStart_toEndOf="@id/container_avatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/textFillColor"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Jogador" />

        <TextView
            android:id="@+id/text_player_scores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textColor="?attr/textFillColor"
            android:textSize="13sp"
            tools:text="Rodada: 150 | Total: 450" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container_action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/icon_rank"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            app:tint="?attr/colorPrimary"
            tools:src="@drawable/ic_crown" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
