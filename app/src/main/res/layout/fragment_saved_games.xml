<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="40dp"
    android:backgroundTint="?attr/customBackground"
    android:background="?attr/customBackground"
    android:fitsSystemWindows="true"
    android:id="@+id/contrai">

    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:paddingVertical="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/text_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:text="@string/king_of_boz"
                android:textColor="?attr/textFillColor"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jogos_salvos"
                android:textColor="?attr/textFillColor"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>


    </LinearLayout>

    <ImageView
        android:id="@+id/image_empty_state_back"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:src="@drawable/imagem_no_list_02"
        android:visibility="invisible"
        app:tint="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"
        app:layout_constraintBottom_toTopOf="@+id/button_marcador_jogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/image_empty_state"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:src="@drawable/imagem_no_list_03"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"
        app:layout_constraintBottom_toTopOf="@+id/button_marcador_jogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_jogos_salvos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/action_bar"
        android:clipToPadding="false"
        android:paddingBottom="225dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"
        tools:layout_editor_absoluteX="0dp"
        tools:listitem="@layout/item_jogo_salvo" />

    <TextView
        android:id="@+id/button_marcador_jogo"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/background_card_btn_repouso_destaque_menu"
        android:backgroundTint="?attr/colorPrimary"
        android:elevation="1dp"
        android:gravity="top|center"
        android:paddingTop="25dp"
        android:text="MARCAR BOZÓ"
        android:textColor="?attr/customTextBackground"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="44dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>