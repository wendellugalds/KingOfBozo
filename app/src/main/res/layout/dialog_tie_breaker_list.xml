<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="24dp"
    android:background="@drawable/background_card_btn_repouso_destaque_menu"
    android:backgroundTint="?attr/customBackground">

    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/background_circle"
        android:backgroundTint="?attr/cardBackgroundColor"
        app:tint="?attr/textFillColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMPATE"
        android:textColor="?attr/colorPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btn_close"
        app:layout_constraintBottom_toBottomOf="@id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dialog_instructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Desempate no dado! \n Escolha o jogador abaixo e selecione \n o ponto que ele tirou na disputa."
        android:textColor="?attr/textFillColor"
        android:textSize="16sp"
        android:alpha="0.8"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_tied_players"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxHeight="300dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_instructions"
        tools:listitem="@layout/item_tie_breaker" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_tie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="CONFIRMAR DESEMPATE"
        android:visibility="gone"
        app:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/customTextBackground"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/recycler_tied_players"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
