<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="?attr/customBackground"
    android:background="?attr/customBackground"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/text_ajustes_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="15dp"
        android:paddingTop="5dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/text_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.5"
            android:text="@string/king_of_boz"
            android:textColor="?attr/textFillColor"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/text_title_jogadores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="AJUSTES"
            android:textColor="?attr/textFillColor"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/button_premium_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="10dp"
            android:background="@drawable/background_circle"
            android:backgroundTint="?attr/colorPrimary"
            android:padding="10dp"
            android:src="@drawable/ic_diamond_shine"
            app:tint="?attr/customTextBackground"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="ContentDescription" />

    </FrameLayout>

    <!-- TEMA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_tema"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/background_settings_card"
        android:backgroundTint="?attr/cardBackgroundColor"
        android:padding="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/card_tela"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_ajustes_title">

        <ImageView
            android:id="@+id/icon_mode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_system_mode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/textFillColor" />

        <TextView
            android:id="@+id/info_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMA"
            android:textColor="?attr/textFillColor"
            android:textSize="15dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/text_mode"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMA"
            android:textColor="?attr/textFillColor"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TELA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_tela"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/background_settings_card"
        android:backgroundTint="?attr/cardBackgroundColor"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/card_tema"
        app:layout_constraintTop_toBottomOf="@+id/text_ajustes_title"
        tools:ignore="MissingConstraints">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_keep_screen_on"
            style="@style/Widget.App.MaterialSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_tela_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TELA"
            android:textColor="?attr/textFillColor"
            android:textSize="15dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/text_tela_title"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_tela_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:text="TELA"
            android:textColor="?attr/textFillColor"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RESET (Agora na Esquerda) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_reset"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/background_settings_card"
        android:backgroundTint="?attr/cardBackgroundColor"
        android:padding="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/card_versao"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_tema">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_limpar_dados"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/text_reset_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIMPAR TUDO"
            android:textColor="?attr/textFillColor"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/text_reset_desc"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_reset_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BANCO DE DADOS"
            android:textColor="?attr/textFillColor"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- VERSÃO (Agora na Direita) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_versao"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/background_settings_card"
        android:backgroundTint="?attr/cardBackgroundColor"
        android:padding="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/card_reset"
        app:layout_constraintTop_toBottomOf="@+id/card_tela">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_version"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/text_versao_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.01"
            android:textColor="?attr/textFillColor"
            android:textSize="15dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/text_versao_title"
            app:layout_constraintStart_toStartOf="parent" />


        <TextView
            android:id="@+id/text_versao_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VERSÃO"
            android:textColor="?attr/textFillColor"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/card_cor"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/background_card_btn_repouso_destaque_menu"
        android:backgroundTint="?attr/colorPrimary"
        android:elevation="1dp"
        android:gravity="top|center"
        android:paddingTop="25dp"
        android:text="COR DESTAQUE"
        android:textColor="?attr/customTextBackground"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>