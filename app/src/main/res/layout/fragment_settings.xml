<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="?attr/customBackground"
    android:background="?attr/customBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/text_ajustes_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:paddingVertical="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/text_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:text="@string/king_of_boz"
                android:textColor="?attr/textFillColor"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ajustes"
                android:textColor="?attr/textFillColor"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/button_premium_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_gold_button"
            android:backgroundTint="@null"
            android:padding="10dp"
            android:src="@drawable/ic_diamond_shine"
            app:tint="@color/premium_text_on_gold"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@+id/text_ajustes_title"
        tools:ignore="MissingConstraints">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_tema"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:background="@drawable/background_settings_card"
                android:backgroundTint="?attr/cardBackgroundColor"
                android:padding="20dp"
                android:layout_gravity="fill"
                android:layout_margin="5dp">

                <ImageView
                    android:id="@+id/icon_mode"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_system_mode"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/textFillColor" />

                <TextView
                    android:id="@+id/info_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEMA"
                    android:textColor="?attr/textFillColor"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/text_mode"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEMA"
                    android:textColor="?attr/textFillColor"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_tela"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:background="@drawable/background_settings_card"
                android:backgroundTint="?attr/cardBackgroundColor"
                android:padding="20dp"
                android:layout_gravity="fill"
                android:layout_margin="5dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_keep_screen_on"
                    style="@style/Widget.App.MaterialSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_tela_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TELA"
                    android:textColor="?attr/textFillColor"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/text_tela_title"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_tela_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:text="TELA"
                    android:textColor="?attr/textFillColor"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_reset"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:background="@drawable/background_settings_card"
                android:backgroundTint="?attr/cardBackgroundColor"
                android:padding="20dp"
                android:layout_gravity="fill"
                android:layout_margin="5dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_limpar_dados"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/text_reset_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIMPAR TUDO"
                    android:textColor="?attr/textFillColor"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/text_reset_desc"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_reset_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BANCO DE DADOS"
                    android:textColor="?attr/textFillColor"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_versao"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:background="@drawable/background_settings_card"
                android:backgroundTint="?attr/cardBackgroundColor"
                android:padding="20dp"
                android:layout_gravity="fill"
                android:layout_margin="5dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_version"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/text_versao_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.01"
                    android:textColor="?attr/textFillColor"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/text_versao_title"
                    app:layout_constraintStart_toStartOf="parent" />


                <TextView
                    android:id="@+id/text_versao_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERSÃO"
                    android:textColor="?attr/textFillColor"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </GridLayout>
    </LinearLayout>



    <TextView
        android:id="@+id/card_cor"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="44dp"
        android:background="@drawable/background_card_btn_repouso_destaque_menu"
        android:backgroundTint="?attr/colorPrimary"
        android:elevation="1dp"
        android:gravity="top|center"
        android:paddingTop="25dp"
        android:text="COR DESTAQUE"
        android:textColor="?attr/customTextBackground"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>